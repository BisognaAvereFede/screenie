{
  "name": "screenie",
  "productName": "Screenie",
  "version": "0.3.1",
  "description": "Client SSH moderno: terminale, screen, SFTP ed editor con salvataggio automatico",
  "main": "electron/main.js",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check electron/ssh.js && node --check electron/store.js",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "author": "BisognaAvereFede",
  "build": {
    "appId": "it.screeniew.app",
    "productName": "Screenie",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Screenie",
      "artifactName": "Screenie-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "Screenie-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BisognaAvereFede",
        "repo": "screenie",
        "releaseType": "release"
      }
    ]
  },
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "electron-updater": "^6.8.11",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BisognaAvereFede/screenie.git"
  }
}
